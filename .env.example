MYSQL_ROOT_PASSWORD=<YOUR_PASSWORD>
MYSQL_DATABASE=<YOUR_DATABASE_NAME>
PARSING_MODEL_API_KEY=<YOUR_API_KEY>

# Document Manager -> local GraphRAG service
GRAPH_RAG_SERVICE_URL=http://host.docker.internal:8002
GRAPH_RAG_DATASET=docspace
# When Document Manager also runs locally, use:
# GRAPH_RAG_SERVICE_URL=http://localhost:8002

# Standalone GraphRAG service (paths are relative to its working directory)
GRAPH_RAG_STATE_DIR=data/graph_rag
LLM_PROVIDER=custom
LLM_MODEL=openrouter/openai/gpt-5-nano
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=<YOUR_API_KEY>
EMBEDDING_PROVIDER=custom
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
EMBEDDING_API_KEY=<YOUR_API_KEY>
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=<YOUR_GRAPH_PASSWORD>
GRAPH_DATABASE_NAME=neo4j
ENABLE_BACKEND_ACCESS_CONTROL=false
ALLOW_CYPHER_QUERY=true
